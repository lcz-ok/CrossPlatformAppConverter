{
  "name": "polyforge-desktop",
  "productName": "POLYFORGE",
  "version": "2.0.0",
  "private": true,
  "description": "Cross-Platform App Converter",
  "author": { "name": "Liu Chenzhi" },
  "main": "main.js",
  "scripts": {
    "sync": "node sync.js",
    "start": "node sync.js && electron .",
    "dist:win": "node sync.js && electron-builder --win portable --x64"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.liuchenzhi.polyforge",
    "productName": "POLYFORGE",
    "directories": { "output": "../release" },
    "files": ["main.js", "index.html", "package.json"],
    "win": {
      "target": [{ "target": "portable", "arch": ["x64"] }],
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "POLYFORGE-2.0.0-Windows-x64.${ext}"
    }
  }
}
